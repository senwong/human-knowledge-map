# Application
PORT=3000
GRAPH_STORE=postgres

# PostgreSQL used by docker-compose
POSTGRES_USER=hkm
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=human_knowledge_map
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

# When running the app outside docker-compose, set DATABASE_URL directly.
# DATABASE_URL=postgresql://hkm:change_this_password@127.0.0.1:5432/human_knowledge_map

# DeepSeek (optional, required for AI expansion)
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-chat
